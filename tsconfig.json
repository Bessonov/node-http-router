{
	"compilerOptions": {
		"target": "es2017",
		"module": "es2022",
		"moduleResolution": "node",
		"esModuleInterop": true,
		"pretty": true,
		"strict": true,
		"alwaysStrict": true,
		"strictNullChecks": true,
		"declaration": true,
		"resolveJsonModule": true,
		"sourceMap": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitOverride": true,						
		"verbatimModuleSyntax": true,
		"rootDir": "./src",
		"outDir": "./dist"
	}
}
