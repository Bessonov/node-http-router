{
	"name": "@bessonovs/node-http-router",
	"version": "3.0.0",
	"description": "Extensible http router for node and micro",
	"keywords": [
		"router",
		"routing",
		"route",
		"micro",
		"match",
		"request",
		"api",
		"rest",
		"typescript",
		"javascript",
		"nodejs",
		"http",
		"server"
	],
	"author": "Anton Bessonov",
	"license": "MIT",
	"repository": "bessonov/node-http-router",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"files": [
		"dist/**/*.js",
		"dist/**/*.js.map",
		"dist/**/*.d.ts",
		"!dist/examples/**",
		"!dist/**/__tests__/**",
		"RELEASE_NOTES.md"
	],
	"type": "module",
	"sideEffects": false,
	"scripts": {
		"start": "pnpm run compile && ultra start:all",
		"start:all": "pnpm run compile:watch || pnpm run test:watch",
		"test": "pnpm run compile && NODE_OPTIONS='--experimental-vm-modules --no-warnings=ExperimentalWarning' jest --coverage",
		"test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --coverage --watchAll",
		"lint": "eslint .",
		"format": "dprint check",
		"format:fix": "dprint fmt",
		"compile": "tsc --build",
		"compile:watch": "tsc --build --watch",
		"example-node-start": "pnpm run compile && node dist/examples/node.js",
		"example-micro-start": "pnpm run compile && node dist/examples/micro.js",
		"precommit": "pnpm run format && pnpm run compile && pnpm test && pnpm run lint",
		"precommit:fix": "pnpm run format:fix && pnpm run compile && pnpm test && pnpm run lint --fix",
		"update": "pnpm update --interactive --recursive --latest"
	},
	"ultra": {
		"concurrent": [
			"start:all"
		]
	},
	"devDependencies": {
		"@eslint/js": "9.39.5",
		"@jest/globals": "30.5.2",
		"@types/express": "5.0.6",
		"@types/jest": "30.0.0",
		"@types/node": "26.6.6",
		"dprint": "0.65.0",
		"eslint": "9.39.5",
		"eslint-plugin-import": "2.32.0",
		"globals": "17.14.0",
		"jest": "30.5.2",
		"micro": "10.0.2",
		"node-mocks-http": "1.18.1",
		"path-to-regexp": "9.0.0",
		"typescript": "6.0.3",
		"typescript-eslint": "8.73.0",
		"ultra-runner": "3.10.5"
	},
	"publishConfig": {
		"access": "public"
	},
	"packageManager": "pnpm@12.21.0",
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "26.13.1",
			"onFail": "download"
		}
	}
}
